# Local React development server port (used by react-scripts).
PORT=3001
# Backend REST API base URL.
REACT_APP_API_BASE_URL=http://localhost:3000
# Preferred WebSocket URL. When unset, the frontend builds it from the API URL
# and REACT_APP_SOCKET_PORT (default 3002).
REACT_APP_SOCKET_URL=ws://localhost:3002
REACT_APP_SOCKET_PORT=3002
