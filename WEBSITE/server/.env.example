# Development only. Create a private .env file; never commit it.
NODE_ENV=development
PORT=3000
SOCKET_PORT=3002
BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
MONGODB_URI=mongodb://localhost:27017/pulse
SESSION_SECRET_PASSCODE=replace-with-a-long-random-value
AUTH_SECRET_ENCODING_PASSPHRASE=replace-with-a-separate-long-random-value
USER_ACTIVATION_TOKEN_SECRET_ENCODING_PASSPHRASE=replace-with-a-separate-long-random-value
USER_CHANGE_PASSWORD_TOKEN_SECRET_ENCODING_PASSPHRASE=replace-with-a-separate-long-random-value
GMAIL_EMAIL=you@example.com
GMAIL_PASSWORD=replace-with-an-app-password
GOOGLE_API_KEY=
# Legacy Gemini model identifier; choose a model accepted by the installed SDK and API.
GOOGLE_MODEL=gemini-pro
# Optional: executable name on PATH, or an absolute path to Rhubarb Lip Sync.
RHUBARB_EXECUTABLE=rhubarb
PYTHON_EXECUTABLE=python3
# Optional private baseline CSV for feedback retraining (blank uses the bundled numerical CSV).
FEEDBACK_DATASET_PATH=
